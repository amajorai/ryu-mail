{
  "id": "@ryu/mail",
  "name": "Mail",
  "version": "1.0.0",
  "description": "Agent Inboxes — email as a service for agents. Runs the out-of-process ryu-mail sidecar; Core proxies /api/mail/* to it. Its sandboxed companion is a per-node mail client (list inboxes, read messages, compose/send, create an inbox) driving /api/mail/* via the mail:crud bridge capability.",
  "tagline": "Email inboxes for your agents",
  "category": "Communication",
  "surfaces": {
    "gateway": { "support": "none" },
    "core": { "support": "full" },
    "desktop": { "support": "full" },
    "island": { "support": "limited" },
    "mobile": { "support": "limited" },
    "extension": { "support": "none" },
    "web": { "support": "full" },
    "cli": { "support": "list" }
  },
  "engines": {
    "ryu": ">=0.1.0"
  },
  "runnables": [
    {
      "id": "mail-companion",
      "name": "Mail",
      "kind": "companion",
      "config": {
        "label": "Agent Inboxes",
        "ui_entry": "./dist/index.html",
        "ui_format": "html"
      }
    }
  ],
  "sidecars": [
    {
      "name": "ryu-mail",
      "process": {
        "kind": "local",
        "command": "ryu-mail",
        "command_env": "RYU_MAIL_BIN",
        "port_env": "RYU_MAIL_PORT"
      },
      "port": 7996,
      "health_path": "/api/mail/status",
      "http": {
        "mount": "/api/mail",
        "public_mount": "/api/mail",
        "max_body_bytes": 27262976,
        "routes": [
          { "path": "/status" },
          { "path": "/inboxes" },
          { "path": "/inboxes/:id" },
          { "path": "/inboxes/:id/rotate-secret" },
          { "path": "/inboxes/:id/messages" },
          { "path": "/inboxes/:id/send" },
          { "path": "/messages/:id" },
          { "path": "/attachments/:id" },
          { "path": "/inbound/:id", "auth": "public" }
        ]
      }
    }
  ],
  "permission_grants": ["mail:crud"],
  "companion": {
    "label": "Agent Inboxes",
    "icon": "mail-01"
  },
  "contributes": {
    "hook_events": [
      {
        "id": "@ryu/mail#message.received",
        "title": "Email received",
        "description": "An inbound message was accepted and stored. Fires once per accepted POST to the inbound webhook, after the per-inbox HMAC verified and the row was written — so a forwarder that retries the same message fires this again. The payload is metadata only; fetch the body with GET /api/mail/messages/:id.",
        "payload_example": {
          "messageId": "0f6d2a1c-3b44-4f0e-9a77-8c1e2d5b6f90",
          "inboxId": "8b3c1f5e-9d24-4a7b-b1c6-2e0f7a4d3c88",
          "direction": "inbound",
          "from": "customer@example.com",
          "to": ["support@node.example"],
          "cc": [],
          "subject": "Invoice for March",
          "inReplyTo": null,
          "attachmentCount": 1,
          "createdAt": "2026-08-01T09:14:22.417Z"
        }
      },
      {
        "id": "@ryu/mail#message.sent",
        "title": "Email sent",
        "description": "An outbound message was handed to the SMTP transport and recorded against the sending inbox. Fires once per successful send; a send that the transport rejects fires nothing. Hand-off is not delivery — providerMessageId is the relay's id, and a later bounce is not visible here.",
        "payload_example": {
          "messageId": "5c9e7b02-1a3d-4e88-9f21-7d0b4c6a2e11",
          "inboxId": "8b3c1f5e-9d24-4a7b-b1c6-2e0f7a4d3c88",
          "direction": "outbound",
          "from": "support@node.example",
          "to": ["customer@example.com"],
          "cc": [],
          "subject": "Re: Invoice for March",
          "inReplyTo": "<abc123@example.com>",
          "providerMessageId": "<9f2b@node.example>",
          "createdAt": "2026-08-01T09:16:03.902Z"
        }
      }
    ]
  }
}
